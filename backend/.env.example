# Backend Environment Variables
# Copy this file to .env and fill in the values

OPENAI_API_KEY=sk-xxxx
# Pipeline v2 (pipeline_v2/) is the default. Set PIPELINE_VERSION=1 only to fall back to the old pipeline in an emergency.
# PIPELINE_VERSION=2
# Pipeline 2 model (default gpt-5.1) and, for GPT-5 models, how much it reasons (none, low, medium, high):
# the writing steps (default low) and the judgement steps, reading the ad and fact-checking (default medium)
# PIPELINE_V2_MODEL=gpt-5.1
# PIPELINE_V2_REASONING=low
# PIPELINE_V2_JUDGE_REASONING=medium
CLERK_SECRET_KEY=sk_test_xxxx
# Required. Trusted Clerk issuer(s), comma-separated (Clerk dashboard > API keys > Frontend API URL)
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
# Optional. Allowed `azp` values; defaults to ALLOWED_ORIGINS
# CLERK_AUTHORIZED_PARTIES=https://cursiva.se,https://www.cursiva.se
DATABASE_URL=postgresql://user:password@localhost:5432/cursiva
FRONTEND_URL=http://localhost:3000
STRIPE_SECRET_KEY=sk_test_xxxx
