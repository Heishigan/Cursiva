{
  "manifest_version": 3,
  "name": "Cursiva Bookmarker",
  "version": "1.0",
  "description": "Bookmark jobs for Cursiva matchmaking",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "*://localhost/*",
    "*://*.cursiva.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Save to Cursiva"
  }
}
